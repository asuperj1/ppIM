{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.configureArgs": [],
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "C_Cpp.default.cppStandard": "c++17",
  "files.associations": {
    "*.proto": "proto3",
    "*.hpp": "cpp",
    "*.h": "cpp"
  },
  "search.exclude": {
    "build/**": true,
    "**/vcpkg_installed/**": true
  }
}
