# =============================================================================
#  deploy/oauth.env.example
#  pp 作为 OAuth 2.0 身份提供方（IdP）的接入方配置
#
#  安装：
#    sudo install -m 600 -o <运行用户> -g <运行用户> oauth.env.example /opt/pp/config/oauth.env
#  然后编辑 /opt/pp/config/oauth.env 填入真实 secret，重启：
#    sudo systemctl restart pp
#
#  说明：
#    · 每次启动都会按本文件「幂等刷新」接入方，改回调白名单不需要动数据库
#    · redirect_uris 是**逗号分隔的精确白名单**，不做前缀/通配匹配
#    · client_secret 只在服务端之间使用，不会下发到浏览器
# =============================================================================

PP_OAUTH_CLIENT_ID=xiaojietong-web
PP_OAUTH_CLIENT_SECRET=请替换为至少32字节的随机串
PP_OAUTH_CLIENT_NAME=校捷通
# 多个回调地址用英文逗号分隔；上线与本地联调可以同时保留
PP_OAUTH_REDIRECT_URIS=https://xiaojietong.online/api/v1/auth/pp/callback,http://127.0.0.1:8080/api/v1/auth/pp/callback
